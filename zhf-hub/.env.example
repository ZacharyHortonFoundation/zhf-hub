# ─── Database ──────────────────────────────────────────────
# Local development: SQLite file (no install needed).
# Production: a PostgreSQL URL (Neon / Supabase / Azure Database for PostgreSQL).
# The schema switches engine automatically from this value (scripts/prisma-provider.mjs).
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ─── Security ──────────────────────────────────────────────
# Long random string used to sign login sessions and donor statement links. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Time zone for all dates/times (the app pins itself to this; default Pacific)
ORG_TIMEZONE="America/Los_Angeles"

# Public URL of the site (emails, Stripe redirects, calendar links). Production must be https://
APP_URL="http://localhost:3000"

# ─── Stripe (leave blank for demo mode) ───────────────────
# Without keys, payments run in DEMO MODE: no card is charged and the
# donation / ticket order is recorded as a test transaction.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Email (leave blank to log emails to the Outbox only) ─
# Resend (https://resend.com). Verify the sending domain first.
RESEND_API_KEY=""
EMAIL_FROM="Zachary Horton Foundation <hello@zacharyhortonfoundation.org>"

# ─── Daily reminders ──────────────────────────────────────
# Any long random string. Vercel Cron sends it automatically as "Authorization: Bearer …".
CRON_SECRET=""

# ─── First admin (only read by `npm run db:init`) ─────────
ADMIN_EMAIL=""
ADMIN_NAME=""
# ADMIN_PASSWORD=""   # optional — a strong temporary one is generated if omitted
