{
  "name": "zhf-hub",
  "version": "0.1.0",
  "private": true,
  "description": "ZHF Hub — donations, events and volunteer management for the Zachary Horton Foundation",
  "scripts": {
    "dev": "node scripts/prisma-provider.mjs --generate && next dev -p 3000",
    "build": "node scripts/prisma-provider.mjs && prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:provider": "node scripts/prisma-provider.mjs && prisma generate",
    "db:push": "node scripts/prisma-provider.mjs && prisma db push",
    "db:deploy": "node scripts/prisma-provider.mjs --generate && prisma db push --skip-generate && tsx scripts/db-lockdown.ts",
    "db:init": "node scripts/prisma-provider.mjs --generate && tsx prisma/init-production.ts",
    "db:seed": "node scripts/prisma-provider.mjs --generate && tsx prisma/seed.ts",
    "db:reset": "node scripts/prisma-provider.mjs && prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "node scripts/prisma-provider.mjs && prisma db push && tsx prisma/seed.ts",
    "postinstall": "node scripts/prisma-provider.mjs && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.18",
    "lucide-react": "^1.79.0",
    "next": "^15.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "server-only": "^0.0.1",
    "stripe": "^23.2.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
